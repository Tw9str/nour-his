# Local runtime identity; never use a PostgreSQL superuser here.
DATABASE_URL=postgresql://nour_app:CHANGE_ME@127.0.0.1:5432/nour_hospital
# Vercel/Neon: set DATABASE_URL to the pooled Neon URL in Vercel settings.
# Set DATABASE_URL_UNPOOLED to the direct URL for migrations and initial seeding.
# DATABASE_URL_UNPOOLED=postgresql://ROLE:PASSWORD@DIRECT_HOST/neondb?sslmode=require
# Set NOUR_ADMIN_PASSWORD for the first deployment (12+ characters).
# NOUR_ADMIN_PASSWORD=
# On Vercel, use the exact customer-facing HTTPS origin, without a trailing slash,
# and set NOUR_TRUST_PROXY=true. Keep each preview database separate from live data.
NOUR_ORIGIN=http://localhost:3000
NOUR_TRUST_PROXY=false
# Optional local development shortcut; always disabled in production.
NOUR_TEST_LOGIN=false
# Generate a random 32-byte hexadecimal backup key. No default.
NOUR_BACKUP_KEY=
NOUR_BACKUP_DIR=./backups
# NOUR_PG_BIN=/path/to/postgresql/bin
# NOUR_RESTORE_TEST_URL=postgresql://restore_operator:CHANGE_ME@127.0.0.1:5432/postgres
