# Inside http {}; replace hostname, subnet and certificates before installation.
limit_req_zone $binary_remote_addr zone=nour_source:10m rate=10r/s;
limit_conn_zone $binary_remote_addr zone=nour_connections:10m;
server {
 listen 443 ssl;
 server_name nour.hospital.internal;
 ssl_certificate /etc/nour/tls/hospital.crt;
 ssl_certificate_key /etc/nour/tls/hospital.key;
 ssl_protocols TLSv1.2 TLSv1.3;
 allow 192.168.10.0/24;
 allow 127.0.0.1;
 deny all;
 client_max_body_size 16k;
 client_header_timeout 10s;
 client_body_timeout 10s;
 limit_req zone=nour_source burst=30 nodelay;
 limit_conn nour_connections 15;
 server_tokens off;
 location / {
  proxy_pass http://127.0.0.1:3000;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For "";
  proxy_set_header Forwarded "";
  proxy_set_header X-Forwarded-Proto https;
  proxy_http_version 1.1;
  proxy_set_header Connection "";
  proxy_buffering off;
  proxy_cache off;
  proxy_read_timeout 60s;
 }
}
